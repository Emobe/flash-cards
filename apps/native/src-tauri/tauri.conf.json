{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flash cards",
  "mainBinaryName": "flash-cards",
  "identifier": "io.github.emobe.flashcards",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Flash cards",
        "width": 1000,
        "height": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; frame-src card: http://card.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Spaced-repetition flash cards",
    "longDescription": "Flash cards with spaced repetition (FSRS), kept on your device. Works offline.",
    "android": {
      "debugApplicationIdSuffix": ".dev"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
