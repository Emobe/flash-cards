{
  "name": "workspace-root",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "android:dev": "bun scripts/android-dev.ts",
    "android:build": "bun run --cwd apps/native tauri android build --debug --apk --target aarch64",
    "android:install": "bun scripts/android-install.ts",
    "dist:linux": "bun scripts/dist-linux.ts",
    "dist:android": "bun scripts/dist-android.ts",
    "dist:android:install": "bun scripts/dist-android-install.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "web:dev": "cargo xtask wasm && bun run --cwd apps/web dev",
    "web:build": "cargo xtask wasm --release && bun run --cwd apps/web build",
    "web:preview": "bun run --cwd apps/web preview"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
